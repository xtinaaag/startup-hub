# Encrypts session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Shared password classmates use to sign in (along with their school email)
AUTH_PASSWORD=

# Email domains allowed to sign in (comma-separated)
ALLOWED_EMAIL_DOMAINS=columbia.edu,gsb.columbia.edu

# Who can create clubs and manage any club (comma-separated emails).
# If empty, EVERYONE is an admin in local dev (never in production).
SUPER_ADMIN_EMAILS=

# Optional: auto-fill postings from a pasted email (any OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: real email verification via Google (LionMail is Google Workspace)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Storage: set automatically when you connect a Vercel Blob store to the project.
# Without it, data is saved to .data/startup-hub.json (local only).
# BLOB_READ_WRITE_TOKEN=
